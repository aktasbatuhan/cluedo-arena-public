# Server Configuration
PORT=3000
MAX_TURNS=120

# Database (Optional - for persistent storage)
# MONGO_URI=mongodb://localhost:27017/cluedo-arena

# Logging
LOG_LEVEL=info

# LLM Backend Configuration
# Options: COHERE, OPENROUTER, PREDIBASE, ART
LLM_BACKEND=OPENROUTER

# LLM Request Timeout (milliseconds)
LLM_REQUEST_TIMEOUT=60000

# API Keys
# Get your API keys from the respective providers:
# - Cohere: https://dashboard.cohere.com/api-keys
# - OpenRouter: https://openrouter.ai/keys
# - Predibase: https://app.predibase.com/

COHERE_API_KEY=your_cohere_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
PREDIBASE_API_KEY=your_predibase_api_key_here

# ART Wrapper Configuration (if using ART backend)
ART_WRAPPER_URL=http://localhost:5001

# Optional Site Metadata
SITE_URL=http://localhost:3000
SITE_NAME=Cluedo AI Arena
